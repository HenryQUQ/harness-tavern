# Copy to .env only if your process manager loads dotenv-style files.
# Harness Tavern reads these values from the process environment.
HT_HOST=127.0.0.1
HT_PORT=8787
HT_DATA_DIR=.ht-data
HT_LOG_LEVEL=info

# Required whenever HT_HOST is not loopback. Generate a long random value.
HT_ACCESS_TOKEN=

# Set this to the externally reachable HTTPS URL behind a reverse proxy.
HT_PUBLIC_URL=http://127.0.0.1:8787
HT_TRUST_PROXY=false
HT_PROVIDER_TIMEOUT_MS=120000
HT_MODEL_CATALOG_TTL_MS=900000
