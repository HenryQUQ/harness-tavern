{
  "name": "harness-tavern",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "description": "A local-first Tavern for portable multi-character Stories with bundled lore, prompts, transforms, and causal runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQUQ/harness-tavern.git"
  },
  "homepage": "https://github.com/HenryQUQ/harness-tavern#readme",
  "bugs": {
    "url": "https://github.com/HenryQUQ/harness-tavern/issues"
  },
  "keywords": [
    "story-runtime",
    "roleplay",
    "llm",
    "sillytavern",
    "deepseek"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "start": "node src/main.js serve",
    "dev": "HT_LOG_LEVEL=debug node --watch src/main.js serve",
    "check": "node scripts/check-source.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage '--test-coverage-include=src/**/*.js' --test-coverage-lines=85 --test-coverage-functions=80 --test-coverage-branches=65 tests/*.test.js",
    "verify:journey": "node scripts/verify-user-journey.js",
    "verify:deepseek": "node scripts/verify-deepseek-causal.js",
    "ci": "npm run check && npm run test:coverage && npm run verify:journey",
    "verify": "npm run ci && npm run doctor",
    "audit": "npm audit --audit-level=high",
    "doctor": "node src/main.js doctor",
    "seed": "node src/main.js seed --force",
    "story:validate": "node scripts/story-source.js validate",
    "story:import": "node scripts/story-source.js import",
    "story:export": "node scripts/story-source.js export",
    "release": "node scripts/build-release.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3"
  }
}
