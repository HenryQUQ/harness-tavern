{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HenryQUQ/harness-tavern/main/schemas/story.schema.json",
  "title": "Harness Tavern editable story source",
  "description": "One versioned story model that can be stored as a self-contained JSON file or as a project manifest with relative resource files.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "story_key",
    "story",
    "characters",
    "cast"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "harness-tavern-story"
    },
    "format_version": {
      "const": 1
    },
    "story_key": {
      "$ref": "#/$defs/key"
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/characterResource"
      }
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/castMember"
      }
    },
    "lorebooks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/lorebookResource"
      }
    },
    "scenes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/sceneResource"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "relativeSource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "story": {
      "type": "object",
      "required": [
        "title",
        "premise",
        "opening_scene"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "hook": {
          "type": "string",
          "maxLength": 1000
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "premise": {
          "type": "string",
          "maxLength": 30000
        },
        "genre": {
          "type": "string",
          "maxLength": 300
        },
        "tone": {
          "type": "string",
          "maxLength": 1000
        },
        "opening_scene": {
          "type": "string",
          "maxLength": 30000
        },
        "player_role": {
          "type": "string",
          "maxLength": 5000
        },
        "world_rules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 3000
          }
        },
        "initial_state": {
          "type": "object"
        },
        "author_notes": {
          "type": "string",
          "maxLength": 30000
        },
        "content_warnings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "cover": {
          "type": "string",
          "maxLength": 200000
        },
        "visibility": {
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "share_policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "characterResource": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "card": {
          "$ref": "character-card.schema.json"
        },
        "source": {
          "$ref": "#/$defs/relativeSource"
        },
        "extensions": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "card"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        },
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "card"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "castMember": {
      "type": "object",
      "required": [
        "character",
        "role"
      ],
      "properties": {
        "character": {
          "$ref": "#/$defs/key"
        },
        "role": {
          "type": "string",
          "maxLength": 1000
        },
        "public_context": {
          "type": "string",
          "maxLength": 10000
        },
        "private_context": {
          "type": "string",
          "maxLength": 10000
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "lorebookResource": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "book": {
          "$ref": "lorebook.schema.json"
        },
        "source": {
          "$ref": "#/$defs/relativeSource"
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "director"
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "book"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        },
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "book"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "sceneResource": {
      "type": "object",
      "required": [
        "key",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "location": {
          "type": "string",
          "maxLength": 1000
        },
        "time": {
          "type": "string",
          "maxLength": 1000
        },
        "objective": {
          "type": "string",
          "maxLength": 10000
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        },
        "source": {
          "$ref": "#/$defs/relativeSource"
        },
        "active_characters": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
