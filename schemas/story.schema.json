{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HenryQUQ/harness-tavern/main/schemas/story.schema.json",
  "title": "Harness Tavern editable story source",
  "description": "One versioned story model that can be stored as a self-contained JSON file or as a project manifest with relative resource files.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "story_key",
    "story",
    "characters",
    "cast"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "harness-tavern-story"
    },
    "format_version": {
      "enum": [1, 2]
    },
    "story_key": {
      "$ref": "#/$defs/key"
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "characters": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/characterResource"
      }
    },
    "cast": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/castMember"
      }
    },
    "lorebooks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/lorebookResource"
      }
    },
    "scenes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/sceneResource"
      }
    },
    "world_schema": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/actionResource"
      }
    },
    "agendas": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/agendaResource"
      }
    },
    "prompt_graph": {
      "type": "object"
    },
    "transforms": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/transform"
      }
    },
    "automations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/automation"
      }
    },
    "state_visibility": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["path", "audience"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$", "maxLength": 500 },
          "audience": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "maxLength": 160 } },
          "note": { "type": "string", "maxLength": 1000 }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "relativeSource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "story": {
      "type": "object",
      "required": [
        "title",
        "premise",
        "opening_scene"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "hook": {
          "type": "string",
          "maxLength": 1000
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "premise": {
          "type": "string",
          "maxLength": 30000
        },
        "genre": {
          "type": "string",
          "maxLength": 300
        },
        "tone": {
          "type": "string",
          "maxLength": 1000
        },
        "opening_scene": {
          "type": "string",
          "maxLength": 30000
        },
        "player_role": {
          "type": "string",
          "maxLength": 5000
        },
        "world_rules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 3000
          }
        },
        "initial_state": {
          "type": "object"
        },
        "author_notes": {
          "type": "string",
          "maxLength": 30000
        },
        "content_warnings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "cover": {
          "type": "string",
          "maxLength": 200000
        },
        "visibility": {
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "share_policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "characterResource": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "card": {
          "$ref": "character-card.schema.json"
        },
        "source": {
          "$ref": "#/$defs/relativeSource"
        },
        "extensions": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "card"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        },
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "card"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "castMember": {
      "type": "object",
      "required": [
        "character",
        "role"
      ],
      "properties": {
        "character": {
          "$ref": "#/$defs/key"
        },
        "role": {
          "type": "string",
          "maxLength": 1000
        },
        "public_context": {
          "type": "string",
          "maxLength": 10000
        },
        "private_context": {
          "type": "string",
          "maxLength": 10000
        },
        "metadata": {
          "type": "object",
          "properties": {
            "actor_runtime": { "$ref": "#/$defs/actorRuntime" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "actorRuntime": {
      "type": "object",
      "properties": {
        "initiative": { "enum": ["reactive", "balanced", "proactive"] },
        "initial_presence": { "enum": ["present", "nearby", "off_scene"] },
        "drives": { "type": "array", "maxItems": 24, "items": { "type": "string", "maxLength": 1000 } },
        "fears": { "type": "array", "maxItems": 24, "items": { "type": "string", "maxLength": 1000 } },
        "values": { "type": "array", "maxItems": 24, "items": { "type": "string", "maxLength": 1000 } },
        "mannerisms": { "type": "array", "maxItems": 24, "items": { "type": "string", "maxLength": 1000 } },
        "reveal_policy": { "type": "string", "maxLength": 3000 }
      },
      "additionalProperties": false
    },
    "lorebookResource": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "book": {
          "$ref": "lorebook.schema.json"
        },
        "source": {
          "$ref": "#/$defs/relativeSource"
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "director"
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "book"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        },
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "book"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "actionResource": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "source": { "$ref": "#/$defs/relativeSource" },
        "label": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 2000 },
        "actor": { "type": "string", "maxLength": 160 },
        "parameters_schema": { "type": "object" },
        "preconditions": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "effects": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "observations": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "outcome": { "type": "string", "maxLength": 200 },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "agendaResource": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "source": { "$ref": "#/$defs/relativeSource" },
        "owner": { "type": "string", "maxLength": 160 },
        "owner_id": { "type": "string", "maxLength": 160 },
        "objective": { "type": "string", "maxLength": 3000 },
        "description": { "type": "string", "maxLength": 3000 },
        "priority": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "enum": ["active", "paused", "completed", "failed"] },
        "triggers": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "constraints": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "next_action": { "type": ["object", "null"] },
        "complete_when": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "fail_when": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "pause_when": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "resume_when": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "visibility": { "enum": ["public", "private", "director"] },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": ["key", "pattern", "replacement", "stages"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "maxLength": 200 },
        "pattern": { "type": "string", "maxLength": 2000 },
        "flags": { "type": "string", "pattern": "^[dgimsuvy]*$", "maxLength": 10 },
        "replacement": { "type": "string", "maxLength": 20000 },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["user_input", "model_input", "model_output", "display", "lore"] }
        },
        "actor": { "type": "string", "maxLength": 160 },
        "enabled": { "type": "boolean" },
        "source": { "type": "string", "maxLength": 160 },
        "trim_strings": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } },
        "substitute_regex": { "type": "integer", "minimum": 0, "maximum": 2 },
        "min_depth": { "type": ["integer", "null"], "minimum": -1, "maximum": 9999 },
        "max_depth": { "type": ["integer", "null"], "minimum": -1, "maximum": 9999 },
        "run_on_edit": { "type": "boolean" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": ["key", "trigger", "prompt"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "maxLength": 200 },
        "trigger": { "enum": ["control", "character", "narration", "prompt.control", "prompt.character", "prompt.narration"] },
        "prompt": { "type": "string", "maxLength": 30000 },
        "role": { "enum": ["system", "user", "assistant"] },
        "priority": { "type": "number", "minimum": 0, "maximum": 100 },
        "order": { "type": "number" },
        "enabled": { "type": "boolean" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "sceneResource": {
      "type": "object",
      "required": [
        "key",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "location": {
          "type": "string",
          "maxLength": 1000
        },
        "time": {
          "type": "string",
          "maxLength": 1000
        },
        "objective": {
          "type": "string",
          "maxLength": 10000
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        },
        "source": {
          "$ref": "#/$defs/relativeSource"
        },
        "active_characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
