{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HenryQUQ/harness-tavern/main/schemas/lorebook.schema.json",
  "title": "Harness Tavern lorebook",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "name",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "harness-tavern-lorebook"
    },
    "format_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "key",
        "title",
        "content"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "keywords": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "director"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "constant": {
          "type": "boolean"
        },
        "position": {
          "type": "integer"
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    }
  }
}
