{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HenryQUQ/harness-tavern/main/schemas/character-card.schema.json",
  "title": "Harness Tavern compatible character card",
  "description": "The Character Card V2-compatible subset used by editable Harness Tavern story sources. V3 cards are accepted as forward-compatible input.",
  "type": "object",
  "required": [
    "spec",
    "spec_version",
    "data"
  ],
  "properties": {
    "spec": {
      "type": "string",
      "pattern": "^chara_card_v[23]$"
    },
    "spec_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "data": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "personality": {
          "type": "string",
          "maxLength": 20000
        },
        "scenario": {
          "type": "string",
          "maxLength": 20000
        },
        "first_mes": {
          "type": "string",
          "maxLength": 20000
        },
        "mes_example": {
          "type": "string",
          "maxLength": 20000
        },
        "creator_notes": {
          "type": "string",
          "maxLength": 20000
        },
        "system_prompt": {
          "type": "string",
          "maxLength": 20000
        },
        "post_history_instructions": {
          "type": "string",
          "maxLength": 10000
        },
        "alternate_greetings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "creator": {
          "type": "string",
          "maxLength": 300
        },
        "character_version": {
          "type": "string",
          "maxLength": 100
        },
        "extensions": {
          "type": "object"
        },
        "character_book": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
